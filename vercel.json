{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "installCommand": "npm install --legacy-peer-deps",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://estra-glimmora-api.onrender.com/api/:path*" },
    { "source": "/auth/:path*", "destination": "https://estra-glimmora-api.onrender.com/auth/:path*" }
  ]
}
