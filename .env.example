# ──────────────────────────────────────────────────────────────────────────
# Glimmora estra — backend .env
#
# Copy this file to .env and fill in your values.
# NEVER commit the real .env file.
# ──────────────────────────────────────────────────────────────────────────

# --- Auth -----------------------------------------------------------------
# JWT_SECRET signs access + refresh tokens. Min 32 chars; rotate per env.
JWT_SECRET=change-me-to-a-random-64-char-hex-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Environment ----------------------------------------------------------
ENV=development
DEBUG=true
LOG_LEVEL=INFO
APP_PORT=8000

# --- Database -------------------------------------------------------------
# Local: SQLite file (the async driver is auto-derived).
# Render/DO prod: replace with the managed Postgres URL.
DATABASE_URL=sqlite:///glimmora.db

# --- File storage ---------------------------------------------------------
RESUME_STORAGE_BACKEND=local
RESUME_STORAGE_LOCAL_DIR=./.local-storage/resumes
RESUME_STORAGE_GCS_BUCKET=
RESUME_MAX_BYTES=10485760

# --- AI provider selection -----------------------------------------------
# auto   = vertex if GCP_SERVICE_ACCOUNT_JSON_B64 is set, else stub.
# stub   = deterministic local provider (the test suite forces this).
# vertex = require GCP creds; production behaviour.
AI_PROVIDER=auto

# --- GCP / Vertex AI -----------------------------------------------------
# Base64 of the service-account JSON. The backend decodes this and derives
# GCP_PROJECT from `project_id` inside the blob.
GCP_SERVICE_ACCOUNT_JSON_B64=
GCP_LOCATION=us-central1

# --- Model selection -----------------------------------------------------
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MODEL_PRO=gemini-2.5-pro

# --- LLM retry budget ----------------------------------------------------
LLM_MAX_RETRIES=1
LLM_INITIAL_BACKOFF=1.0
LLM_REQUEST_TIMEOUT_S=60

# Enable AI-generated 6-point area explanations.
USE_AI_AREA_EXPLANATIONS=true
