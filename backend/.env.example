# Glimmora Backend - Environment Variables
# Copy this file to .env and fill in your values

# JWT - CHANGE THIS IN PRODUCTION
SECRET_KEY=change-me-to-a-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database
# Development (SQLite):
# DATABASE_URL=sqlite:///./glimmora.db
# Production (Neon PostgreSQL):
# DATABASE_URL=postgresql://user:pass@ep-xxx.aws.neon.tech/db
DATABASE_URL=sqlite:///./glimmora.db

# ─── GCP Vertex AI (used for every Gemini call) ──────────────────────────
# Project + region for the Vertex endpoint.
GCP_PROJECT_ID=
GCP_LOCATION=us-central1
# Whole service-account JSON, base64-encoded. Decoded at runtime in
# app/core/llm.py to build google.oauth2 Credentials. Avoids shipping a
# JSON file in containers / git.
# To produce: `cat sa.json | base64 -w0`  (Linux/mac)
#             `[Convert]::ToBase64String([IO.File]::ReadAllBytes("sa.json"))`  (PowerShell)
GCP_SERVICE_ACCOUNT_JSON_B64=

# Single model used for every non-2D LLM call (QA, deep-dive, intent
# parser, area explanations, comparison, ranking explanation).
GEMINI_MODEL=gemini-2.5-flash

# Retry budget for transient Vertex errors (429/503 only).
LLM_MAX_RETRIES=1
LLM_INITIAL_BACKOFF=1.0

# ─── Legacy Google AI Studio API key (deprecated, not read by new code) ──
GEMINI_API_KEY=
INTENT_MODEL=gemini-2.5-flash
QA_MODEL=gemini-2.5-flash

# Toggle AI-generated area explanations vs the template fallback.
# Keep false in shared/dev environments to cap Gemini cost.
USE_AI_AREA_EXPLANATIONS=false

# Seed users (created on first boot)
SEED_SUPER_ADMIN_EMAIL=superadmin@glimmora.ai
SEED_SUPER_ADMIN_PASSWORD=superadmin123
SEED_SUPER_ADMIN_NAME=Super Admin
SEED_SUPER_ADMIN_COUNTRY=India

SEED_ADMIN_EMAIL=admin@glimmora.ai
SEED_ADMIN_PASSWORD=admin123
SEED_ADMIN_NAME=Admin
SEED_ADMIN_COUNTRY=India

# Frontend URL (for CORS) — comma-separate multiple origins
FRONTEND_URL=http://localhost:3000,http://localhost:3001

# ─── Razorpay ────────────────────────────────────────────────────────────
# Test or live keys. RAZORPAY_KEY_ID is also exposed to the browser via
# the Next.js NEXT_PUBLIC_RAZORPAY_KEY_ID env var.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
